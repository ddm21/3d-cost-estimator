# ----------------------------------------------------
# Caddy Production Configuration
# ----------------------------------------------------

# Replace 'example.com' with your actual domain name.
# When you do, Caddy will automatically talk to Let's Encrypt
# and provision an auto-renewing SSL certificate.

example.com {
    # This forwards all incoming traffic to the Node.js / Astro container
    # 'app' is the hostname of the service in docker-compose.prod.yml
    reverse_proxy app:4321

    # Optional security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
    }
}
