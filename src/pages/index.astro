---
import { config } from '../config';
import QuoteEngine from '../components/QuoteEngine.svelte';
import '../styles/global.css';
---

<html lang="en" class="dark">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{config.brand.name} | Instant 3D Print Quote</title>
		<meta name="description" content="Upload your 3D models and get an instant, accurate quotation for 3D printing." />
		
		<!-- Modern Google Font: Outfit for headings, Inter for body -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Outfit:wght@400;500;700&display=swap" rel="stylesheet">
	</head>
	<body class="bg-zinc-950 text-zinc-100 font-sans antialiased min-h-screen selection:bg-indigo-500/30 selection:text-indigo-200">
		<div class="fixed inset-0 z-[-1] bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(120,119,198,0.3),rgba(255,255,255,0))]"></div>
		
		<main class="max-w-[1000px] mx-auto p-4 md:p-8 relative">
			<header class="mb-12 text-center">
				<div class="inline-block mb-3 px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-xs font-semibold tracking-wide uppercase">
					Powered by {config.brand.name}
				</div>
				<h1 class="text-4xl md:text-5xl font-bold font-heading tracking-tight mb-4 text-transparent bg-clip-text bg-gradient-to-r from-zinc-100 to-zinc-500">
					Instant 3D Printing Quote
				</h1>
				<p class="text-zinc-400 max-w-xl mx-auto">
					Upload your STL, OBJ, or 3MF files to get a real-time estimate based on our proprietary volume and time algorithms.
				</p>
			</header>

			<!-- The interactive Svelte App mounts here -->
			<QuoteEngine client:idle />
			
		</main>

		<footer class="text-center py-12 text-zinc-500 text-sm">
			&copy; {new Date().getFullYear()} {config.brand.name}. All rights reserved.
		</footer>
	</body>
</html>

<style is:global>
	/* Setup some global CSS variables if needed */
	:root {
		--font-heading: 'Outfit', sans-serif;
		--font-sans: 'Inter', sans-serif;
	}
	body {
		font-family: var(--font-sans);
	}
	h1, h2, h3, h4, h5, h6, .font-heading {
		font-family: var(--font-heading);
	}
</style>
